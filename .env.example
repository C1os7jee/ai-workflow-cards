# Copy this file to .env and fill in local-only secrets.
# Never commit .env.

# OpenAI API key, used when the project calls OpenAI models or image APIs.
OPENAI_API_KEY=

# Optional OpenAI-compatible gateway. For direct OpenAI, leave empty.
# Example: https://naiccc.com
OPENAI_BASE_URL=

# Optional: default image model for future API-backed generation.
OPENAI_IMAGE_MODEL=gpt-image-2

# DeepSeek text planner used to plan dynamic image jobs before rendering.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro

# Volcengine Ark / Seedream image generation.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
